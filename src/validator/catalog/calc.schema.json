{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "buteemj:catalog/calc",
  "title": "calc/*.yaml — тооцооны граф (ST1611–1613)",
  "description": "Тооцооны граф: оролт, зангилаа, гаралт, тест. Сервер: Package.cpp (ачаалах), SolutionDeploy.cpp plan/calcs(), calc/Calc.cpp (шалгалт).",
  "type": "object",
  "required": ["name", "nodes", "outputs"],
  "properties": {
    "name": { "type": "string", "description": "Тооцооны нэр (давхардахгүй, ST161102)", "x-source": "cgi/src/solution/SolutionDeploy.cpp:2581" },
    "version": { "type": "integer", "minimum": 1, "description": "Хувилбар — экспорт бичдэг, суулгахад сервер өөрөө дугаарлана (мэдээллийн)", "x-source": "cgi/src/solution/ModelExport.cpp:840" },
    "description": { "type": "string", "description": "Тайлбар (ST161104)", "x-source": "cgi/src/solution/SolutionDeploy.cpp:4858" },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" }, "description": "Оролтууд", "x-source": "cgi/src/solution/SolutionDeploy.cpp:4869" },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" }, "description": "Тооцоолох зангилаанууд", "x-source": "cgi/src/solution/SolutionDeploy.cpp:4931" },
    "outputs": { "type": "array", "items": { "type": "string", "description": "Гаралт болох зангилааны нэр" }, "description": "Гаралтын зангилаанууд (calc(<нэр>).<гаралт>)", "x-source": "cgi/src/solution/SolutionDeploy.cpp:4810" },
    "tests": { "type": "array", "items": { "$ref": "#/$defs/test" }, "description": "Жишээ тестүүд (ST1613)", "x-source": "cgi/src/solution/SolutionDeploy.cpp:4978" }
  },
  "$defs": {
    "valueType": { "type": "string", "enum": ["decimal", "integer", "text", "boolean", "date", "any"], "description": "Зангилааны утгын төрөл", "x-source": "cgi/src/calc/Calc.cpp:18" },
    "rounding": { "type": "string", "enum": ["half-up", "half-even", "floor", "ceil", "down", "up"], "description": "Дугуйлах горим (scale-тэй хамт)", "x-source": "cgi/src/calc/Decimal.cpp:107" },
    "input": {
      "type": "object",
      "required": ["name"],
      "properties": {
